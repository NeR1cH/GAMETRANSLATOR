```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Backup files
*.backup

# Virtual environments
.venv/
venv/
env/

# Dependencies
node_modules/

# Logs and temporary files
*.log
*.tmp
*.swp

# Environment variables
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Build artifacts
build/
dist/
target/
```